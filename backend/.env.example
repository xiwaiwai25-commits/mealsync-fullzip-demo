MEALSYNC_SECRET=replace-with-a-long-random-secret-before-deployment
MEALSYNC_DB_PATH=mealsync.db
MEALSYNC_MEDIA_DIR=uploads
MEALSYNC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo administrator account (override before deployment)
MEALSYNC_ADMIN_EMAIL=admin@mealsync.test
MEALSYNC_ADMIN_PASSWORD=replace-with-a-private-random-password

# Optional: enables vendor AI food-image generation
OPENAI_API_KEY=
